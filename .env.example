# Global Treasury Forecasting & Liquidity Engine -- environment configuration
#
# Copy this file to .env (untracked -- see .gitignore) to get a real, editable config
# file. Loaded by app/core/config.py (pydantic-settings, prefix TREASURY_, see Settings
# there for the authoritative field list/types). Every value below is already the
# built-in default -- this file exists so they're visible and overridable in one place
# instead of hunting through config.py. Restart the server after editing; settings are
# read once at process startup.

# --- Data source ---
# "csv" is the only implemented backend today. "postgres" is a placeholder in
# app/data/repository.py (PostgresDataRepository) -- DB choice is still open, see notes.txt.
TREASURY_DATA_BACKEND=csv

# Path to the CSV, absolute or relative to the current working directory. Left commented out
# so the code's own default applies instead (repo-root/Business_Report.csv, resolved from
# config.py's own location -- correct regardless of where `uvicorn` is launched from). Only
# uncomment if you actually need to point at a different file/location.
# TREASURY_CSV_PATH=Business_Report.csv

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
TREASURY_LOG_LEVEL=INFO

# --- Forecasting defaults ---
# Every one of these is also overridable per-request in the API body (see
# app/api/schemas.py::ForecastRequest) -- these are just the fallback values.
TREASURY_DEFAULT_HORIZON_DAYS=30
TREASURY_MAX_HORIZON_DAYS=365
# JSON list. Only these transstatus values count as real, funded volume by default -- see
# CLAUDE.md on why transstatus has 11 real-world values, not just Payment/Cancel/Block.
TREASURY_DEFAULT_INCLUDE_STATUSES=["Payment"]
